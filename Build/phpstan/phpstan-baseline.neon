parameters:
	ignoreErrors:
		-
			message: '#^Method Pelago\\Emogrifier\\Tests\\Support\\Constraint\\CssConstraint\:\:getCssMatcherAllowingOptionalTrailingSemicolon\(\) should return string but returns array\<string\>\|string\.$#'
			identifier: return.type
			count: 1
			path: ../../tests/Support/Constraint/CssConstraint.php

		-
			message: '#^Parameter \#2 \$array of static method PHPUnit\\Framework\\Assert\:\:assertArrayHasKey\(\) expects array\|ArrayAccess, array\<string\>\|null given\.$#'
			identifier: argument.type
			count: 1
			path: ../../tests/Unit/Css/CssDocumentTest.php

		-
			message: '#^Binary operation "\." between ''\<style type\="text…'' and array\<string\>\|string results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: ../../tests/Unit/CssInlinerTest.php

		-
			message: '#^Binary operation "\." between mixed and ''\</style\>'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: ../../tests/Unit/CssInlinerTest.php

		-
			message: '#^Parameter \#1 \$css of method Pelago\\Emogrifier\\CssInliner\:\:inlineCss\(\) expects string, array\<string\>\|string given\.$#'
			identifier: argument.type
			count: 1
			path: ../../tests/Unit/CssInlinerTest.php

		-
			message: '#^Binary operation "\." between ''%%'' and array\<string\>\|string results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: ../../tests/Unit/HtmlProcessor/AbstractHtmlProcessorTest.php

		-
			message: '#^Binary operation "\." between mixed and ''%%'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: ../../tests/Unit/HtmlProcessor/AbstractHtmlProcessorTest.php

		-
			message: '#^Method Pelago\\Emogrifier\\Tests\\Unit\\HtmlProcessor\\AbstractHtmlProcessorTest\:\:normalizeHtmlElement\(\) should return string but returns array\<string\>\|string\.$#'
			identifier: return.type
			count: 1
			path: ../../tests/Unit/HtmlProcessor/AbstractHtmlProcessorTest.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: ../../tests/Unit/HtmlProcessor/HtmlPrunerTest.php

		-
			message: '#^Offset 1 might not exist on array\|null\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: ../../tests/Unit/HtmlProcessor/HtmlPrunerTest.php

		-
			message: '#^Parameter \#1 \$string of static method Pelago\\Emogrifier\\Tests\\Unit\\HtmlProcessor\\HtmlPrunerTest\:\:assertMinified\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../tests/Unit/HtmlProcessor/HtmlPrunerTest.php
